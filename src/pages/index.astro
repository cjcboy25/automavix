---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Automavix | Next-Gen Enterprise Automation Systems">
	<main class="max-w-6xl mx-auto px-6">
		
		<!-- Hero Section -->
		<section class="pt-24 pb-20 text-center relative">
			<!-- Glowing element -->
			<div class="absolute top-0 left-1/2 -translate-x-1/2 w-72 h-72 bg-blue-500/10 blur-[120px] rounded-full pointer-events-none"></div>
			
			<span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-white/5 border border-white/10 text-slate-300 backdrop-blur-sm mb-6">
				<span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span> Now Live: Astro Migration v1.0
			</span>
			
			<h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight max-w-4xl mx-auto leading-[1.1] mb-6">
				Intelligent Business Orchestration, <span class="bg-gradient-to-r from-blue-400 via-indigo-200 to-purple-400 bg-clip-text text-transparent">Built to Scale.</span>
			</h1>
			
			<p class="text-lg text-slate-400 max-w-2xl mx-auto mb-10 font-light">
				Automavix coordinates workflows, AI models, and infrastructure operations safely beneath a unified command pipeline.
			</p>
			
			<div class="flex justify-center gap-4">
				<a href="#features" class="bg-blue-600 hover:bg-blue-500 px-6 py-3 rounded-xl font-medium text-white transition shadow-lg shadow-blue-600/20">
					Explore Platform
				</a>
				<a href="https://automavix.framer.website/" target="_blank" class="bg-white/5 hover:bg-white/10 border border-white/10 px-6 py-3 rounded-xl font-medium text-slate-300 transition">
					View Original Design
				</a>
			</div>
		</section>

		<!-- Features Bento Box Grid -->
		<section id="features" class="py-20 border-t border-white/5">
			<h2 class="text-2xl sm:text-3xl font-bold tracking-tight mb-12 text-center">Engineered for absolute performance</h2>
			
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				<!-- Card 1 -->
				<div class="group relative bg-white/[0.02] border border-white/5 rounded-2xl p-6 hover:border-white/10 transition">
					<div class="p-3 bg-blue-500/10 rounded-xl text-blue-400 w-fit mb-4">🧬</div>
					<h3 class="text-lg font-semibold mb-2 group-hover:text-blue-400 transition">Autonomous Orchestration</h3>
					<p class="text-sm text-slate-400 font-light">Zero-touch setup flows matching dynamic microservices automatically.</p>
				</div>
				<!-- Card 2 -->
				<div class="group relative bg-white/[0.02] border border-white/5 rounded-2xl p-6 hover:border-white/10 transition">
					<div class="p-3 bg-purple-500/10 rounded-xl text-purple-400 w-fit mb-4">⚡</div>
					<h3 class="text-lg font-semibold mb-2 group-hover:text-purple-400 transition">Lightning Static Build</h3>
					<p class="text-sm text-slate-400 font-light">Powered entirely by Astro static generation for sub-100ms loads.</p>
				</div>
				<!-- Card 3 -->
				<div class="group relative bg-white/[0.02] border border-white/5 rounded-2xl p-6 hover:border-white/10 transition">
					<div class="p-3 bg-emerald-500/10 rounded-xl text-emerald-400 w-fit mb-4">🛡️</div>
					<h3 class="text-lg font-semibold mb-2 group-hover:text-emerald-400 transition">GitOps Security</h3>
					<p class="text-sm text-slate-400 font-light">Every update is backed by secure GitHub code reviews and approvals.</p>
				</div>
			</div>
		</section>

	</main>
</Layout>
